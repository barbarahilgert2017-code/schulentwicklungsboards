# ---- Pflicht ----
# Öffentliche Domain (für Caddy/HTTPS), z. B. boards.meine-schule.de
DOMAIN=boards.meine-schule.de
# Geheimer Schlüssel (mind. 32 Zeichen), erzeugen mit: openssl rand -hex 32
# ACHTUNG: Ohne diesen Schlüssel sind gespeicherte Nextcloud-Verbindungen nicht mehr nutzbar – sicher aufbewahren!
APP_SECRET=

# ---- Allgemein ----
APP_NAME=Schulentwicklungsboards
BASE_URL=https://boards.meine-schule.de
# Registrierung offen? Die erste Person darf sich immer registrieren und wird Admin.
ALLOW_REGISTRATION=true
# Registrierung nur mit diesen E-Mail-Domains (kommagetrennt), leer = alle
REGISTRATION_EMAIL_DOMAINS=meine-schule.de
SESSION_DAYS=14
UPLOAD_MAX_MB=50

# ---- Nextcloud ----
# Vorbelegte Adresse der Schul-Nextcloud
NEXTCLOUD_DEFAULT_URL=https://cloud.meine-schule.de
# Nur diese Nextcloud-Hosts erlauben (empfohlen). Bei genau einem Host + DEFAULT_URL ist das Feld fest vorgegeben.
NEXTCLOUD_ALLOWED_HOSTS=cloud.meine-schule.de
# Basisordner für Board-Ordner in der Nextcloud der verknüpfenden Person
NEXTCLOUD_BASE_FOLDER=Schulentwicklung
# Name, unter dem die App in Nextcloud bei „Geräte & Sitzungen“ erscheint
NEXTCLOUD_CLIENT_NAME=Schulentwicklungsboards
# Nur für Tests / interne Netze:
# NEXTCLOUD_ALLOW_INSECURE_HTTP=false
# NEXTCLOUD_ALLOW_PRIVATE_NETWORKS=false
